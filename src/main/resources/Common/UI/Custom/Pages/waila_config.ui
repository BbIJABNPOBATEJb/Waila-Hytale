$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@InputLabel = Label {
  Anchor: (Left: 6, Right: 16, Width: 280);
  Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
};

$C.@PageOverlay #WailaConfigPage {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 520);

    #Title {
      $C.@Title {
        @Text = %waila.customUI.waila.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Description {
        Anchor: (Bottom: 16, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c0c7d1, HorizontalAlignment: Center);
          Text: %waila.customUI.waila.description;
      }

      Group #Show {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.show;
        }

        $C.@CheckBox #ShowCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group #ShowBlockName {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.showBlockName;
        }

        $C.@CheckBox #ShowBlockNameCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group #ShowModName {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.showModName;
        }

        $C.@CheckBox #ShowModNameCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group #ShowBlockId {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.showId;
        }

        $C.@CheckBox #ShowBlockIdCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group #ShowToolEfficiency {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.showTool;
        }

        $C.@CheckBox #ShowToolEfficiencyCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

        Group #ShowCropInfo {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        @InputLabel {
          Text: %waila.customUI.waila.showCrop;
        }

        $C.@CheckBox #ShowCropInfoCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group #ShowItemIcon {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        @InputLabel {
          Text: %waila.customUI.waila.showItemIcon;
        }

        $C.@CheckBox #ShowItemIconCheck {
          Anchor: (Width: 26, Height: 26);
        }
      }

      Group {
        Anchor: (Vertical: 16, Height: 1);
        Background: #5e512c(0.4);
      }


      Group #Buttons {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #SaveButton {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Right: 4);
          Text: %waila.customUI.waila.save;
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #CloseButton {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Left: 4);
          Text: %waila.customUI.waila.cancel;
          FlexWeight: 1;
        }
      }
    }
  }
}